model Post{
    id String @default(uuid())
    title String @db.varchar(255)
    content String @db.text
    thubnail String?
    isFeatured Boolean @default(false)
    status PostStatus @default(PUBLISHED)
    tags String[]
    views Int @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    @@map("posts")
}