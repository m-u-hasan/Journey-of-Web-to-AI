model Post{
    id String #id #default (UUID())
    title string @db.varchar(255)
    content string @db text
    thubnail string?
    isFeatured Bookean @default(false)
    status PostStatus @default(PUBLISHED)
    tags String[]
    views Int @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updateAt

    @@map("posts")
}